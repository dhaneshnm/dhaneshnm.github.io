---
import Base from "../layouts/Base.astro";

const linkedin = "https://www.linkedin.com/in/dhanesh-neela-mana-ab63a01a/";
const x = "https://x.com/dneelamana";
const substack = "https://dhaneshneelamana.substack.com";
const github = "https://github.com/dhaneshnm";

// Reverse chronological. Newest first.
const work = [
  {
    years: "2025–26",
    org: "Master Ed",
    text: "CTO and co-founder. Voice roleplay for training. We ran pilots with two universities and one company.",
  },
  {
    years: "2022–24",
    org: "Tamedia",
    text: "Zürich. I took over a codebase that was falling apart and a team people kept quitting. Two years later nobody had quit and the team was twice the size.",
  },
  { years: "2019–22", org: "EPFL", text: "Blue Brain Project. Front end for the knowledge graph." },
  { years: "2017–19", org: "Amazon", text: "Front end, React." },
  { years: "2013–17", org: "Front Rush", text: "Sports recruiting software, .NET and Rails." },
  { years: "2008–11", org: "TCS", text: ".NET apps for banks." },
];
---

<Base>
  <header>
    <div class="wrap header-inner">
      <a class="name" href="/">Dhanesh Neela Mana</a>
      <nav aria-label="Site">
        <ul>
          <li><a href="#now">Now</a></li>
          <li><a href="#work">Work</a></li>
          <li><a href="#follow">Follow</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section class="wrap grid hero">
      <div class="hero-text">
        <h1>
          Building for how people <span class="mark"
            >learn<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"
              ><path
                d="M2 12 C 40 4, 80 18, 120 9 S 180 6, 198 11"
                fill="none"
                stroke="var(--red)"
                stroke-width="4"
                stroke-linecap="round"></path><path
                d="M14 17 C 60 12, 120 19, 186 14"
                fill="none"
                stroke="var(--red)"
                stroke-width="2.5"
                stroke-linecap="round"></path></svg
            ></span>.
        </h1>
        <p>
          I've shipped software for eighteen years, most recently as CTO of an
          ed-tech startup. Now I build apps that help people learn.
        </p>
        <p>I post progress on <a href={linkedin}>LinkedIn</a> and <a href={x}>X</a>.</p>
      </div>
      <div class="margin">
        <img
          src="/dhanesh.jpg"
          alt="Dhanesh Neela Mana"
          width="400"
          height="400"
          fetchpriority="high"
        />
        <div class="cap">
          <svg width="26" height="30" viewBox="0 0 26 30" aria-hidden="true">
            <path
              d="M22 28 C 8 24, 4 14, 6 3 M2 8 L6 2 L11 7"
              fill="none"
              stroke="var(--red)"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <span>me, College Station, Texas</span>
        </div>
      </div>
    </section>

    <section class="wrap grid row" id="now">
      <h2>Now</h2>
      <div>
        <p>
          I am building an app that helps people learn about art and enjoy
          it. It starts with paintings that museums around the world have
          released under CC0, so anyone can use them. An LLM is the tutor.
        </p>
        <p>
          In 1984, Benjamin Bloom found that students with a one-to-one tutor
          score two standard deviations higher than students in a class.
          Schools cannot pay for one tutor for each student. An LLM can be a
          tutor at a low cost. I want to know if an LLM can teach art.
        </p>
      </div>
    </section>

    <section class="wrap grid row" id="work">
      <h2>Work</h2>
      <table>
        {
          work.map((w) => (
            <tr>
              <td>{w.years}</td>
              <td>
                <b>{w.org}</b>. {w.text}
              </td>
            </tr>
          ))
        }
      </table>
    </section>

    <section class="wrap grid row" id="follow">
      <h2>Follow</h2>
      <div>
        <p>
          Build notes go on <a href={linkedin}>LinkedIn</a>. Shorter, daily
          stuff on <a href={x}>X, @dneelamana</a>. Longer essays on{" "}
          <a href={substack}>Substack</a>. Code on <a href={github}>GitHub</a>.
        </p>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>Dhanesh Neela Mana, 2026</span>
      <span>College Station, Texas</span>
    </div>
  </footer>
</Base>
