---
import Base from "../layouts/Base.astro";

// "Now" section. Update the date and lines together, roughly monthly.
// Lines marked TODO(Dhanesh) render on the page on purpose; replace them.
const nowUpdated = "Sep 2026";
const now = [
  "TODO(Dhanesh): October app line",
  "Writing on LinkedIn about building software in the LLM era.",
  "TODO(Dhanesh): who you want to talk to",
  "TODO(Dhanesh): Tondo status after the Sep 30 review (live or closed)",
];

const linkedin = "https://www.linkedin.com/in/dhanesh-neela-mana-ab63a01a/";
const x = "https://x.com/dneelamana";
const substack = "https://dhaneshneelamana.substack.com";
const github = "https://github.com/dhaneshnm";

const timeline = [
  { org: "TCS", role: ".NET web apps for banks", note: "2008" },
  { org: "Front Rush", role: "Sports recruiting software in .NET and Rails", note: "4 years" },
  { org: "Amazon", role: "Front-end engineering in React" },
  { org: "EPFL", role: "Front end for a knowledge graph at the Blue Brain Project" },
  {
    org: "Tamedia",
    role: "Rescued a failing codebase and a high-attrition team. Two years on, nobody had left and the team had doubled.",
    note: "still proud of this one",
  },
  {
    org: "AI startup",
    role: "CTO and co-founder. Built a voice-first roleplay training product end to end and took an enterprise pilot live on the committed date.",
    current: true,
  },
];
---

<Base>
  <header>
    <div class="wrap header-inner">
      <a class="wordmark" href="/">Dhanesh Neela Mana</a>
      <nav aria-label="Site">
        <ul>
          <li><a href="#now">Now</a></li>
          <li><a href="#about">About</a></li>
          <li><a href={linkedin}>Writing</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <p class="eyebrow">
            <span>Solo founder</span><span class="dot" aria-hidden="true">●</span><span
              >Learning &amp; education</span
            >
          </p>
          <h1>Building for how<br />people <em>learn.</em></h1>
          <p>
            I've built software for other people since 2008. Now I build my own
            learning apps, one at a time. Each one starts with a written bet and
            a kill date.{" "}
            <em>My bar is behavior change, not completion.</em>
          </p>
          <div class="cta">
            <a class="btn" href={linkedin}>
              Follow on LinkedIn
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4"></path>
              </svg>
            </a>
            <a class="ghost" href={x}>Follow @dneelamana on X</a>
          </div>
        </div>
        <img
          class="portrait"
          src="/dhanesh.jpg"
          alt="Dhanesh Neela Mana"
          width="400"
          height="400"
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="rail" id="now">
      <div class="wrap rail-grid">
        <div class="label">Now<small>Updated {nowUpdated}</small></div>
        <ul class="now-list">
          {now.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </section>

    <section class="rail" id="about">
      <div class="wrap rail-grid">
        <div class="label">About</div>
        <div>
          <p>I'm Dhanesh. I've built software since 2008, across six different rooms:</p>
          <ol class="timeline">
            {
              timeline.map((t) => (
                <li class:list={{ current: t.current }}>
                  <span class="org">{t.org}</span>
                  <span class="role">
                    {t.role}
                    {t.note && <span> · {t.note}</span>}
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="outro">
            Every side project I've ever loved was about learning: flashcards,
            e-book tools, teaching apps. Now it's the main project. I live in
            College Station, Texas.
          </p>
        </div>
      </div>
    </section>

    <section class="rail" id="follow">
      <div class="wrap rail-grid">
        <div class="label">Follow along</div>
        <div>
          <p>I write on LinkedIn. X is for the day-to-day.</p>
          <ul class="links">
            <li><a href={linkedin}><b>LinkedIn</b> Profile</a></li>
            <li><a href={x}><b>X</b> @dneelamana</a></li>
            <li><a href={github}><b>GitHub</b> Code</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>© 2026 Dhanesh Neela Mana</span>
      <a href={substack}>Essays on Substack</a>
      <span>College Station, Texas</span>
    </div>
  </footer>
</Base>
