---
import Base from "../layouts/Base.astro";

// "Now" section. Update the date and lines together, roughly monthly.
// TODO: replace placeholder lines with real ones before deploying.
const nowUpdated = "Sep 2026";
const now = [
  "Prototyping a spaced-practice app for skills, not facts. First testers this month.",
  "Writing weekly on Substack about what actually makes learning stick.",
  "Talking to teachers and self-learners. If that is you, reply on X.",
];

const timeline = [
  { org: "TCS", role: ".NET banking systems", note: "2008" },
  { org: "Front Rush", role: "Recruiting products used by 100,000 athletes" },
  { org: "Amazon", role: "Front-end engineering" },
  { org: "EPFL", role: "Semantic search for brain research" },
  { org: "Tamedia", role: "Legacy-platform rescue, Switzerland", note: "still proud of this one" },
  {
    org: "AI startup",
    role: "CTO & co-founder. Built a voice-first roleplay training product end to end.",
    current: true,
  },
];
---

<Base>
  <header>
    <div class="wrap header-inner">
      <a class="wordmark" href="/">Dhanesh Neela Mana</a>
      <nav aria-label="Site">
        <ul>
          <li><a href="#now">Now</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="https://dhaneshneelamana.substack.com/">Writing</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <p class="eyebrow">
            <span>Solo founder</span><span class="dot" aria-hidden="true">●</span><span
              >Learning &amp; education</span
            >
          </p>
          <h1>Building for how<br />people <em>learn.</em></h1>
          <p>
            After 18 years building software for other people, I'm building my
            own. Tools that help people build real skills and make them stick.{" "}
            <em>My bar is behavior change, not completion.</em>
          </p>
          <div class="cta">
            <a class="btn" href="https://dhaneshneelamana.substack.com/">
              Read on Substack
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4"></path>
              </svg>
            </a>
            <a class="ghost" href="https://twitter.com/dneelamana">Follow @dneelamana</a>
          </div>
        </div>
        <img
          class="portrait"
          src="/dhanesh.jpg"
          alt="Dhanesh Neela Mana"
          width="400"
          height="400"
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="rail" id="now">
      <div class="wrap rail-grid">
        <div class="label">Now<small>Updated {nowUpdated}</small></div>
        <ul class="now-list">
          {now.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </section>

    <section class="rail" id="about">
      <div class="wrap rail-grid">
        <div class="label">About</div>
        <div>
          <p>I'm Dhanesh. I've built software since 2008, across six very different rooms:</p>
          <ol class="timeline">
            {
              timeline.map((t) => (
                <li class:list={{ current: t.current }}>
                  <span class="org">{t.org}</span>
                  <span class="role">
                    {t.role}
                    {t.note && <span> · {t.note}</span>}
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="outro">
            Every side project I've ever loved was about learning: flashcards,
            e-book tools, teaching apps. Now it's the main project. I live in
            College Station, Texas.
          </p>
        </div>
      </div>
    </section>

    <section class="rail" id="follow">
      <div class="wrap rail-grid">
        <div class="label">Follow along</div>
        <div>
          <p>I build in public. X for the day-to-day, Substack for the longer write-ups.</p>
          <ul class="links">
            <li><a href="https://twitter.com/dneelamana"><b>X</b> @dneelamana</a></li>
            <li><a href="https://dhaneshneelamana.substack.com/"><b>Substack</b> Essays</a></li>
            <li>
              <a href="https://www.linkedin.com/in/dhanesh-neela-mana-ab63a01a/"><b>LinkedIn</b> Profile</a>
            </li>
            <li><a href="https://github.com/dhaneshnm"><b>GitHub</b> Code</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>© 2026 Dhanesh Neela Mana</span>
      <span>College Station, Texas</span>
    </div>
  </footer>
</Base>
