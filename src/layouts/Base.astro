---
const title = "Dhanesh Neela Mana · Building for how people learn";
const description =
  "Eighteen years shipping software, most recently as CTO of an ed-tech startup. Now building apps that help people learn. College Station, Texas.";
const ogDescription = description;
const canonical = "https://dneelamana.com/";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fcfcfa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://dneelamana.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Dhanesh Neela Mana · ${ogDescription}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dneelamana" />
    <meta name="twitter:image" content="https://dneelamana.com/og.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;600;700&family=Shantell+Sans:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* Red Pen: a printed textbook page marked up by a teacher. Single light look.
         Three columns: section heading, text, margin. The margin holds red notes, never labels. */
      :root {
        --paper: #fcfcfa;
        --ink: #1d1c1a;
        --pencil: #6b675f;
        --red: #c0392b;
        --rule: #e3e1db;
        --maxw: 1000px;
        --print: "Spectral", Georgia, "Times New Roman", serif;
        --hand: "Shantell Sans", "Comic Sans MS", cursive;
        color-scheme: light;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--print);
        font-size: 19px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 20px;
      }

      a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: var(--red);
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
      }
      a:hover {
        color: var(--red);
      }
      a:focus-visible {
        outline: 2px solid var(--red);
        outline-offset: 3px;
        border-radius: 2px;
      }
      ::selection {
        background: #f3d6d2;
      }

      /* ---------- Header ---------- */
      header {
        border-bottom: 1px solid var(--rule);
      }
      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-top: 22px;
        padding-bottom: 22px;
        gap: 12px;
        flex-wrap: wrap;
      }
      .name {
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
      }
      nav ul {
        display: flex;
        gap: 24px;
        list-style: none;
        font-size: 0.95rem;
      }
      nav a {
        text-decoration: none;
      }

      /* ---------- Grid ---------- */
      .grid {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr) 220px;
        gap: 32px;
      }

      /* ---------- Hero ---------- */
      .hero {
        padding-top: 64px;
        padding-bottom: 56px;
      }
      .hero-text {
        grid-column: 1 / 3;
        min-width: 0;
      }
      h1 {
        font-weight: 600;
        font-size: clamp(2.2rem, 5.4vw, 3.7rem);
        line-height: 1.1;
        letter-spacing: -0.015em;
        margin-bottom: 28px;
        text-wrap: balance;
      }
      .mark {
        position: relative;
        white-space: nowrap;
      }
      .mark svg {
        position: absolute;
        left: -6%;
        bottom: -0.2em;
        width: 112%;
        height: 0.34em;
        overflow: visible;
      }
      .hero-text p,
      .row p {
        max-width: 34em;
      }
      .hero-text p + p,
      .row p + p {
        margin-top: 14px;
      }

      /* ---------- Margin notes ---------- */
      .margin {
        font-family: var(--hand);
        font-weight: 500;
        color: var(--red);
        font-size: 0.88rem;
        line-height: 1.4;
        display: grid;
        gap: 18px;
        align-content: start;
      }
      .margin img {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        display: block;
        filter: grayscale(1) contrast(1.05);
        border-radius: 50%;
      }
      .cap {
        display: flex;
        gap: 8px;
        align-items: flex-start;
      }
      .cap svg {
        flex: none;
      }

      /* ---------- Sections ---------- */
      .row {
        border-top: 1px solid var(--rule);
        padding-top: 40px;
        padding-bottom: 40px;
      }
      h2 {
        font-size: 1.1rem;
        font-weight: 700;
        font-variant: small-caps;
        letter-spacing: 0.05em;
      }

      /* ---------- Work ---------- */
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.98rem;
      }
      td {
        padding: 10px 0;
        border-bottom: 1px solid var(--rule);
        vertical-align: baseline;
      }
      td:first-child {
        width: 96px;
        color: var(--pencil);
        font-variant-numeric: oldstyle-nums;
        white-space: nowrap;
      }
      td b {
        font-weight: 600;
      }

      /* ---------- Footer ---------- */
      footer {
        border-top: 1px solid var(--rule);
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 22px;
        padding-bottom: 56px;
        color: var(--pencil);
        font-size: 0.9rem;
      }

      /* ---------- Mobile ---------- */
      @media (max-width: 800px) {
        body {
          font-size: 18px;
        }
        .grid {
          grid-template-columns: minmax(0, 1fr);
          gap: 18px;
        }
        .hero-text {
          grid-column: auto;
        }
        .hero {
          padding-top: 40px;
          padding-bottom: 40px;
        }
        .hero .margin {
          grid-template-columns: 110px minmax(0, 1fr);
          align-items: start;
        }
        td:first-child {
          width: 76px;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
