---
const title = "Dhanesh Neela Mana — Building for how people learn";
const description =
  "Solo founder building learning software — tools that help people build real skills and make them stick. 18 years across banking, sports tech, Amazon, EPFL neuroscience, Swiss media, and an AI startup as CTO.";
const ogDescription =
  "Solo founder building learning software — skills that stick, not content that gets marked done.";
const canonical = "https://dneelamana.com/";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://dneelamana.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Dhanesh Neela Mana — ${ogDescription}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://dneelamana.com/og.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --paper: #fbfbf8;
        --ink: #1c1e1d;
        --ink-soft: #5c615e;
        --line: #e2e3dc;
        --line-strong: #c9cbc2;
        --ship: #177245;
        --build: #9a5b00;
        --kill: #b3261e;
        --maxw: 860px;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: "Atkinson Hyperlegible", system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      .wrap {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 24px;
      }

      a {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }
      a:hover {
        text-decoration-thickness: 2.5px;
      }
      a:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
        border-radius: 1px;
      }

      .mono {
        font-family: "IBM Plex Mono", monospace;
      }

      /* ---------- Header ---------- */
      header {
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 20px 0;
        gap: 16px;
        flex-wrap: wrap;
      }
      .wordmark {
        font-family: "IBM Plex Mono", monospace;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
      }
      nav ul {
        display: flex;
        gap: 20px;
        list-style: none;
      }
      nav a {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-decoration: none;
        color: var(--ink-soft);
      }
      nav a:hover {
        color: var(--ink);
        text-decoration: underline;
      }

      /* ---------- Hero ---------- */
      .hero {
        padding: 88px 0 56px;
      }
      .eyebrow {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 20px;
      }
      h1 {
        font-family: "Archivo", sans-serif;
        font-weight: 900;
        font-size: clamp(2.6rem, 7vw, 4.4rem);
        line-height: 1.02;
        letter-spacing: -0.02em;
        margin-bottom: 28px;
      }
      .hero p {
        max-width: 620px;
        font-size: 1.1rem;
        color: var(--ink);
      }

      /* ---------- Rules ---------- */
      .rules {
        border-top: 1px solid var(--line);
        padding: 40px 0;
      }
      .rules-grid {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 24px;
      }
      .section-label {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
        padding-top: 4px;
      }
      .rules p {
        max-width: 620px;
      }
      .rules p + p {
        margin-top: 14px;
      }

      /* ---------- About ---------- */
      .about {
        border-top: 1px solid var(--line);
        padding: 40px 0;
      }
      .about-grid {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 24px;
      }
      .about p {
        max-width: 620px;
      }
      .about p + p {
        margin-top: 14px;
      }

      /* ---------- Follow ---------- */
      .follow {
        border-top: 1px solid var(--line);
        padding: 40px 0 64px;
      }
      .follow-grid {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 24px;
      }
      .follow p {
        max-width: 620px;
        margin-bottom: 20px;
      }
      .link-list {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 28px;
        list-style: none;
      }
      .link-list a {
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.85rem;
      }

      /* ---------- Footer ---------- */
      footer {
        border-top: 1px solid var(--line);
        padding: 24px 0 48px;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        font-family: "IBM Plex Mono", monospace;
        font-size: 0.75rem;
        color: var(--ink-soft);
      }

      /* ---------- Motion ---------- */
      @media (prefers-reduced-motion: no-preference) {
        .hero,
        .rules,
        .about,
        .follow {
          animation: rise 0.5s ease both;
        }
        .rules {
          animation-delay: 0.06s;
        }
        .about {
          animation-delay: 0.12s;
        }
        .follow {
          animation-delay: 0.18s;
        }
        @keyframes rise {
          from {
            opacity: 0;
            transform: translateY(10px);
          }
          to {
            opacity: 1;
            transform: none;
          }
        }
      }

      /* ---------- Mobile ---------- */
      @media (max-width: 640px) {
        .rules-grid,
        .about-grid,
        .follow-grid {
          grid-template-columns: 1fr;
          gap: 12px;
        }
        .hero {
          padding: 56px 0 40px;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
